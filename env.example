# Database (Neon Postgres)
DATABASE_URL="postgresql://neondb_owner:xxx@ep-xxx.neon.tech/neondb?sslmode=require"

# NextAuth
AUTH_SECRET="your_nextauth_secret_generate_with_openssl_rand_base64_32"
AUTH_TWITTER_ID="your_twitter_oauth_client_id"
AUTH_TWITTER_SECRET="your_twitter_oauth_client_secret"

# RapidAPI (Twitter)
RAPID_API_KEY="your_rapid_api_key"

# App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin allowlist (comma-separated Twitter IDs/subjects)
ADMIN_TWITTER_IDS="123456789,987654321"
