{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@vault/ui": ["../../packages/vault-ui/src"],
      "@vault/ui/*": ["../../packages/vault-ui/src/*"],
      "@vault/database": ["../../packages/database/src"],
      "@vault/auth": ["../../packages/auth/src"],
      "@vault/twitter-service": ["../../packages/twitter-service/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
