# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Privy Auth
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id"

# RapidAPI (Twitter verification)
RAPID_API_KEY="your_rapid_api_key"

# App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin allowlist (comma-separated Twitter IDs/subjects)
ADMIN_TWITTER_IDS="twitter_id_1,twitter_id_2"
ADMIN_EMAILS="admin@example.com"

# Node environment
NODE_ENV=development

# OpenAI (for AI features)
OPENAI_API_KEY="sk-..."

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Vercel Cron Secret
# Generate a secure random string for this
# Used to authenticate Vercel cron job requests
# In Vercel: Settings > Environment Variables > Add CRON_SECRET
CRON_SECRET="your_secure_random_string"

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=
