generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum MarketStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  RESOLVED
  SETTLED
  CANCELLED
}

enum MarketCategory {
  NFL
  NBA
  NHL
  MLB
  SOCCER
  UFC
  TENNIS
  GOLF
  ESPORTS
  POLITICS
  CRYPTO
  FINANCE
  ENTERTAINMENT
  OTHER
}

enum BetStatus {
  PENDING_TWEET  // Awaiting tweet verification
  CONFIRMED      // Tweet verified, bet active
  WON            // Market resolved, user won
  LOST           // Market resolved, user lost
  REJECTED       // Bet rejected
  CANCELLED      // Bet cancelled
}

enum BalanceReason {
  INITIAL_CREDIT
  BET_PLACED
  SETTLEMENT_PAYOUT
  SETTLEMENT_LOSS
  ADMIN_ADJUST
  REFERRAL_BONUS
  OTHER
}

enum RaffleReason {
  CORRECT_PREDICTION
  REFERRAL_BONUS
}

enum TweetProofMethod {
  TIMELINE_SCAN
  TWEET_URL
}

enum AdminAction {
  EVENT_CREATE
  EVENT_UPDATE
  MARKET_CREATE
  MARKET_UPDATE
  MARKET_CLOSE
  MARKET_RESOLVE
  MARKET_SETTLE
  USER_ROLE_UPDATE
}

// ============================================================================
// USER
// ============================================================================

model User {
  id              String    @id @default(cuid())
  
  // Privy identity fields
  privyUserId     String    @unique
  email           String?
  walletAddress   String?
  twitterSubject  String?   // Twitter OAuth subject/ID
  
  // Profile fields
  handle          String?
  name            String?
  profileImageUrl String?
  
  // Role
  role            UserRole  @default(USER)
  
  // Balance
  balance         Int       @default(10000)
  balanceLocked   Boolean   @default(false)
  
  // Referral
  referralCode    String    @unique @default(cuid())
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  bets            Bet[]
  positions       Position[]
  balanceLedger   BalanceLedger[]
  tweetProofs     TweetProof[]
  raffleEntries   RaffleEntry[]
  
  // Referrals (as referrer)
  referralsGiven  Referral[] @relation("ReferrerUser")
  // Referrals (as referred)
  referralReceived Referral? @relation("ReferredUser")
  
  // Admin actions performed
  adminActions    AdminActionLog[]
  
  // Balance ledger entries where this admin made adjustment
  adminAdjustments BalanceLedger[] @relation("AdminActor")

  @@index([email])
  @@index([twitterSubject])
  @@index([referralCode])
}

// ============================================================================
// BALANCE LEDGER (Audit)
// ============================================================================

model BalanceLedger {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  delta           Int           // Can be positive or negative
  balanceBefore   Int
  balanceAfter    Int
  
  reason          BalanceReason
  correlationId   String?       // e.g., bet ID, settlement run ID
  
  // If admin made this adjustment
  actorAdminUserId String?
  actorAdmin       User?        @relation("AdminActor", fields: [actorAdminUserId], references: [id])
  
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([correlationId])
  @@index([createdAt])
}

// ============================================================================
// TAG (Polymarket-style categorization)
// ============================================================================

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events    Event[]
}

// ============================================================================
// EVENT (Polymarket-style: groups related markets)
// ============================================================================

model Event {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  description     String?        @db.Text
  
  // Categorization
  category        MarketCategory @default(OTHER)
  
  // Media
  bannerUrl       String?
  logoUrl         String?
  
  // Timestamps
  startTime       DateTime?      // When the event starts (e.g., game kickoff)
  endTime         DateTime?      // When the event ends
  
  // State flags (Polymarket-style)
  active          Boolean        @default(true)
  closed          Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  markets         Market[]
  tags            Tag[]

  @@index([category])
  @@index([active])
  @@index([closed])
  @@index([startTime])
}

// ============================================================================
// MARKET (Binary outcome market within an Event)
// ============================================================================

model Market {
  id              String        @id @default(cuid())
  
  // Parent event
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Question (the specific binary question)
  question        String
  
  // Outcomes as JSON arrays (Polymarket style)
  // e.g., ["Yes", "No"] or ["Chiefs", "Eagles"]
  outcomes        String        @default("[\"Yes\", \"No\"]")
  // e.g., ["0.50", "0.50"] - calculated from pool ratios
  outcomePrices   String        @default("[\"0.50\", \"0.50\"]")
  // Optional colors for each outcome, e.g., ["#FF0000", "#0000FF"]
  outcomeColors   String?
  
  status          MarketStatus  @default(DRAFT)
  
  // Details (Markdown)
  detailsMarkdown String?       @db.Text
  
  // Resolution
  resolutionSourceUrl String?
  resolvedOutcome     Int?      // Index into outcomes array (0 or 1), null until resolved
  
  // Timestamps
  publishedAt     DateTime?
  opensAt         DateTime?
  closesAt        DateTime?
  resolvedAt      DateTime?
  settledAt       DateTime?
  
  // Settlement idempotency
  settlementRunId String?       @unique
  
  // Pari-mutuel params
  feeBps          Int           @default(100)    // 1% = 100 basis points
  seed0           Int           @default(1000)   // Bootstrap liquidity for outcome[0]
  seed1           Int           @default(1000)   // Bootstrap liquidity for outcome[1]
  
  // Pool tracking (denormalized for performance)
  pool0           Int           @default(0)      // Total confirmed bets on outcome[0]
  pool1           Int           @default(0)      // Total confirmed bets on outcome[1]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  bets            Bet[]
  positions       Position[]
  tweetProofs     TweetProof[]
  raffleEntries   RaffleEntry[]

  @@index([eventId])
  @@index([status])
  @@index([closesAt])
  @@index([publishedAt])
}

// ============================================================================
// BET (Ledger)
// ============================================================================

model Bet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  marketId      String
  market        Market    @relation(fields: [marketId], references: [id])
  
  // Outcome index (0 or 1) - index into market.outcomes array
  outcomeIndex  Int
  
  amount        Int
  weight        Float     @default(1)
  payout        Int?      // Calculated payout after settlement (null until settled)
  
  status        BetStatus @default(PENDING_TWEET)
  
  // Tweet proof reference
  tweetProofId  String?
  tweetProof    TweetProof? @relation(fields: [tweetProofId], references: [id])
  
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?

  @@index([userId])
  @@index([marketId])
  @@index([outcomeIndex])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// POSITION (Aggregate per user per market)
// ============================================================================

model Position {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  
  // Aggregated amounts per outcome (only confirmed bets)
  amount0         Int      @default(0)  // Bet amount on outcomes[0]
  amount1         Int      @default(0)  // Bet amount on outcomes[1]
  
  // Weighted aggregates
  weighted0       Float    @default(0)
  weighted1       Float    @default(0)
  
  lastBetAt       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, marketId])
  @@index([userId])
  @@index([marketId])
}

// ============================================================================
// REFERRAL
// ============================================================================

model Referral {
  id                  String    @id @default(cuid())
  
  referrerUserId      String
  referrer            User      @relation("ReferrerUser", fields: [referrerUserId], references: [id])
  
  referredUserId      String    @unique
  referred            User      @relation("ReferredUser", fields: [referredUserId], references: [id])
  
  createdAt           DateTime  @default(now())
  qualifiedAt         DateTime? // When referred user placed first confirmed bet
  bonusEntriesAwarded Int       @default(0)

  @@index([referrerUserId])
}

// ============================================================================
// RAFFLE ENTRY
// ============================================================================

model RaffleEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  
  marketId  String
  market    Market       @relation(fields: [marketId], references: [id])
  
  entries   Int          @default(1)
  reason    RaffleReason
  
  createdAt DateTime     @default(now())

  @@unique([userId, marketId, reason])
  @@index([userId])
  @@index([marketId])
}

// ============================================================================
// TWEET PROOF
// ============================================================================

model TweetProof {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  
  marketId    String
  market      Market           @relation(fields: [marketId], references: [id])
  
  method      TweetProofMethod
  tweetUrl    String?
  tweetId     String?
  verified    Boolean          @default(false)
  matchedText String?
  raw         Json?            // Minimal captured response snippet
  
  createdAt   DateTime         @default(now())
  verifiedAt  DateTime?

  // Relations
  bets        Bet[]

  @@index([userId])
  @@index([marketId])
  @@index([verified])
}

// ============================================================================
// ADMIN ACTION LOG
// ============================================================================

model AdminActionLog {
  id            String      @id @default(cuid())
  adminUserId   String
  admin         User        @relation(fields: [adminUserId], references: [id])
  
  action        AdminAction
  targetType    String      // e.g., "Event", "Market", "User"
  targetId      String
  metadata      Json?
  
  createdAt     DateTime    @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
