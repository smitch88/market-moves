// ============================================================================
// CONFIGURATION
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id              String   @id @default(cuid())
  privyUserId     String   @unique
  email           String?
  walletAddress   String?
  twitterSubject  String?
  handle          String?  @unique // Custom username
  name            String? // Display name
  profileImageUrl String?
  role            UserRole @default(USER)

  // Financial tracking
  balance       Decimal @default(10000.00) @db.Decimal(19, 2)
  balanceLocked Boolean @default(false)
  realizedPnL   Decimal @default(0.0000) @db.Decimal(19, 4)
  totalVolume   Decimal @default(0.00) @db.Decimal(19, 2)

  // Gamification
  xp           Int    @default(0) // Total XP earned
  referralCode String @unique @default(cuid())

  // UI state
  hasSeenWelcomeModal Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  adminActions     AdminActionLog[]
  adminAdjustments BalanceLedger[]   @relation("AdminActor")
  balanceLedger    BalanceLedger[]
  xpLedger         XPLedger[]
  xpAdjustments    XPLedger[]        @relation("XPAdminActor")
  pnlLedger        PnLLedger[]
  bets             Bet[]
  positions        Position[]
  raffleEntries    RaffleEntry[]
  referralReceived       Referral?         @relation("ReferredUser")
  referralsGiven         Referral[]        @relation("ReferrerUser")
  tweetProofs            TweetProof[]
  pnlSnapshots           UserPnLSnapshot[]
  marketRequests         MarketRequest[]
  marketRequestsReviewed MarketRequest[]   @relation("MarketRequestReviewer")
  bookmarks              Bookmark[]
  xpTradeTrackers        XPTradeTracker[]
  xpDailyTotals          XPDailyTotal[]

  @@index([email])
  @@index([twitterSubject])
  @@index([referralCode])
  @@index([handle])
}

// ============================================================================
// FINANCIAL LEDGERS & TRACKING
// ============================================================================

/// Balance ledger for tracking all balance changes (deposits, withdrawals, bets, payouts)
model BalanceLedger {
  id               String        @id @default(cuid())
  userId           String
  delta            Decimal       @db.Decimal(19, 2)
  balanceBefore    Decimal       @db.Decimal(19, 2)
  balanceAfter     Decimal       @db.Decimal(19, 2)
  reason           BalanceReason
  correlationId    String? // Links to bet/trade/transaction ID
  actorAdminUserId String? // If admin initiated
  createdAt        DateTime      @default(now())

  // Relations
  actorAdmin User? @relation("AdminActor", fields: [actorAdminUserId], references: [id])
  user       User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([correlationId])
  @@index([createdAt])
}

/// PnL ledger for audit trail of all profit/loss changes
model PnLLedger {
  id            String    @id @default(cuid())
  userId        String
  delta         Decimal   @db.Decimal(19, 4) // PnL change (positive or negative)
  pnlBefore     Decimal   @db.Decimal(19, 4)
  pnlAfter      Decimal   @db.Decimal(19, 4)
  reason        PnLReason
  correlationId String? // Links to bet/position ID
  marketId      String? // Related market
  metadata      Json? // Additional details (shares, price, etc.)
  createdAt     DateTime  @default(now())

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  market Market? @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([reason])
  @@index([correlationId])
  @@index([marketId])
}

/// Snapshot of user's PnL at a point in time (for charts/history)
model UserPnLSnapshot {
  id            String   @id @default(cuid())
  userId        String
  realizedPnL   Decimal  @db.Decimal(19, 4)
  unrealizedPnL Decimal  @db.Decimal(19, 4)
  totalVolume   Decimal  @db.Decimal(19, 2)
  createdAt     DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ============================================================================
// XP & GAMIFICATION
// ============================================================================

/// XP ledger for tracking all XP changes
model XPLedger {
  id            String   @id @default(cuid())
  userId        String
  delta         Int // XP change (positive or negative)
  xpBefore      Int
  xpAfter       Int
  reason        XPReason
  correlationId String? // Links to bet/trade ID
  adminUserId   String? // If admin adjustment
  createdAt     DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  admin User? @relation("XPAdminActor", fields: [adminUserId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([reason])
  @@index([correlationId])
}

/// XP configuration (how much XP per dollar, etc.)
model XPConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String // JSON string for flexibility
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String? // Admin ID who last updated
}

/// Tracks XP-related trading activity per user per market per day
/// Used for anti-abuse protections: cooldowns, diminishing returns, caps
model XPTradeTracker {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  date      DateTime @db.Date // Date only (no time) for daily tracking
  
  // Tracking metrics
  tradeCount      Int      @default(0) // Number of trades today in this market
  totalVolume     Decimal  @default(0) @db.Decimal(20, 2) // Total $ volume today in this market
  xpEarned        Int      @default(0) // XP earned from this market today
  lastTradeAt     DateTime @default(now()) // Last trade timestamp (for cooldown)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  
  @@unique([userId, marketId, date])
  @@index([userId, date])
  @@index([marketId])
  @@index([lastTradeAt])
}

/// Tracks daily XP totals per user (for daily cap enforcement)
model XPDailyTotal {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date // Date only
  
  totalXpEarned    Int     @default(0) // Total XP earned today from trading
  totalVolume      Decimal @default(0) @db.Decimal(20, 2) // Total volume traded today
  tradesCount      Int     @default(0) // Total trades today across all markets
  marketsTraded    Int     @default(0) // Unique markets traded today
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ============================================================================
// EVENTS & MARKETS
// ============================================================================

/// Tags for categorizing events
model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  events Event[] @relation("EventToTag")
}

/// Events are the top-level container for markets (e.g., "Super Bowl LX")
model Event {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  category    MarketCategory @default(OTHER)
  eventType   EventType      @default(MATCHUP)
  bannerUrl   String?
  logoUrl     String?
  startTime   DateTime?
  endTime     DateTime?
  active      Boolean        @default(true)
  closed      Boolean        @default(false)
  featured    Boolean        @default(false) // Show in featured carousel
  isPublished Boolean        @default(false) // Whether event is visible on public site
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  markets   Market[]
  tags      Tag[]      @relation("EventToTag")
  bookmarks Bookmark[]

  @@index([category])
  @@index([eventType])
  @@index([active])
  @@index([closed])
  @@index([startTime])
  @@index([featured])
  @@index([isPublished])
}

/// Markets are individual prediction questions within an event
model Market {
  id                  String       @id @default(cuid())
  question            String
  status              MarketStatus @default(DRAFT)
  isPublished         Boolean      @default(false) // Whether market is visible on public site
  detailsMarkdown     String?
  resolutionSourceUrl String?
  publishedAt         DateTime?
  opensAt             DateTime?
  closesAt            DateTime?
  resolvedAt          DateTime?
  settledAt           DateTime?
  settlementRunId     String?      @unique
  feeBps              Int          @default(100) // Fee in basis points (100 = 1%)

  // Market configuration
  eventId         String
  displayLabel    String? // Short label for grouped display (e.g., "<116M", "Bad Bunny")
  sortOrder       Int? // Explicit sort order within event (lower = first)
  outcomes        String  @default("[\"Yes\", \"No\"]") // JSON array of outcome labels
  outcomePrices   String  @default("[\"0.50\", \"0.50\"]") // JSON array of prices
  resolvedOutcome Int? // Index of winning outcome

  // AMM/CPMM fields
  pool0        Decimal      @default(0.00) @db.Decimal(19, 2)
  pool1        Decimal      @default(0.00) @db.Decimal(19, 2)
  seed0        Decimal      @default(100000.00) @db.Decimal(19, 2)
  seed1        Decimal      @default(100000.00) @db.Decimal(19, 2)
  k            Decimal?     @db.Decimal(38, 4) // Constant product k = reserve0 * reserve1
  pricingModel PricingModel @default(CPMM)
  reserve0     Decimal      @default(100000) @db.Decimal(19, 2)
  reserve1     Decimal      @default(100000) @db.Decimal(19, 2)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resolution source linkage
  resolutionSourceId String?
  resolutionSource   ResolutionSource? @relation(fields: [resolutionSourceId], references: [id], onDelete: SetNull)

  // Relations
  bets                 Bet[]
  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  positions            Position[]
  priceSnapshots       PriceSnapshot[]
  raffleEntries        RaffleEntry[]
  tweetProofs          TweetProof[]
  pnlLedger            PnLLedger[]
  resolutionDataPoints ResolutionDataPoint[]
  xpTradeTrackers      XPTradeTracker[]

  @@index([eventId])
  @@index([status])
  @@index([closesAt])
  @@index([publishedAt])
  @@index([pricingModel])
  @@index([isPublished])
  @@index([resolutionSourceId])
}

/// Price snapshots for historical price tracking
model PriceSnapshot {
  id        String   @id @default(cuid())
  marketId  String
  price0    Decimal  @db.Decimal(10, 4)
  price1    Decimal  @db.Decimal(10, 4)
  pool0     Decimal  @db.Decimal(19, 2)
  pool1     Decimal  @db.Decimal(19, 2)
  timestamp DateTime @default(now())

  // Relations
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, timestamp])
  @@index([timestamp])
}

// ============================================================================
// BETTING & TRADING
// ============================================================================

/// Bets/trades represent user actions on markets
model Bet {
  id           String    @id @default(cuid())
  userId       String
  marketId     String
  amount       Decimal   @db.Decimal(19, 2)
  weight       Float     @default(1) // Raffle weight multiplier
  payout       Decimal?  @db.Decimal(19, 2)
  status       BetStatus @default(PENDING_TWEET)
  tweetProofId String?
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?

  // AMM/CPMM fields
  outcomeIndex  Int // Which outcome (0 or 1)
  pricePerShare Decimal?  @db.Decimal(10, 4) // Price per share at time of trade
  shares        Decimal?  @db.Decimal(19, 4) // Number of shares bought/sold
  tradeType     TradeType @default(BUY)

  // Relations
  market     Market      @relation(fields: [marketId], references: [id])
  tweetProof TweetProof? @relation(fields: [tweetProofId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([outcomeIndex])
  @@index([status])
  @@index([createdAt])
  @@index([tradeType])
  @@index([userId, tradeType, status]) // For PnL calculations
  @@index([userId, status, createdAt]) // For time-based PnL queries
}

/// Positions represent user's holdings in a market
model Position {
  id       String @id @default(cuid())
  userId   String
  marketId String

  // Legacy fields (deprecated)
  amount0   Decimal @default(0.00) @db.Decimal(19, 2)
  amount1   Decimal @default(0.00) @db.Decimal(19, 2)
  weighted0 Float   @default(0)
  weighted1 Float   @default(0)

  // AMM/CPMM fields
  shares0  Decimal @default(0) @db.Decimal(19, 4)
  shares1  Decimal @default(0) @db.Decimal(19, 4)
  avgCost0 Decimal @default(0) @db.Decimal(10, 4) // Average cost per share
  avgCost1 Decimal @default(0) @db.Decimal(10, 4)

  // Metadata
  lastBetAt DateTime?
  claimedAt DateTime? // When user claimed their payout for this position
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  market Market @relation(fields: [marketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, marketId])
  @@index([userId])
  @@index([marketId])
  @@index([userId, claimedAt]) // For unclaimed positions queries
}

// ============================================================================
// SOCIAL & VERIFICATION
// ============================================================================

/// Tweet proof for social verification of bets
model TweetProof {
  id          String           @id @default(cuid())
  userId      String
  marketId    String
  method      TweetProofMethod
  tweetUrl    String?
  tweetId     String?
  verified    Boolean          @default(false)
  matchedText String?
  raw         Json? // Raw tweet data
  createdAt   DateTime         @default(now())
  verifiedAt  DateTime?

  // Relations
  bets   Bet[]
  market Market @relation(fields: [marketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([verified])
}

// ============================================================================
// REFERRALS & REWARDS
// ============================================================================

/// Referral tracking
model Referral {
  id                  String    @id @default(cuid())
  referrerUserId      String
  referredUserId      String    @unique
  createdAt           DateTime  @default(now())
  qualifiedAt         DateTime?
  bonusEntriesAwarded Int       @default(0)

  // Relations
  referred User @relation("ReferredUser", fields: [referredUserId], references: [id])
  referrer User @relation("ReferrerUser", fields: [referrerUserId], references: [id])

  @@index([referrerUserId])
}

/// Raffle entries for giveaways/promotions
model RaffleEntry {
  id        String       @id @default(cuid())
  userId    String
  marketId  String
  entries   Int          @default(1)
  reason    RaffleReason
  createdAt DateTime     @default(now())

  // Relations
  market Market @relation(fields: [marketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, marketId, reason])
  @@index([userId])
  @@index([marketId])
}

// ============================================================================
// MARKET REQUESTS (KOL Feature)
// ============================================================================

/// Market request from users (KOL feature)
model MarketRequest {
  id          String              @id @default(cuid())
  userId      String
  title       String
  description String
  sourceUrl   String? // Optional URL to Polymarket/Kalshi
  status      MarketRequestStatus @default(PENDING)
  adminNotes  String? // Admin response/notes
  reviewedAt  DateTime?
  reviewedBy  String? // Admin user ID who reviewed
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  user     User  @relation(fields: [userId], references: [id])
  reviewer User? @relation("MarketRequestReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// BOOKMARKS
// ============================================================================

/// User bookmarks for events
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ============================================================================
// ADMIN & SYSTEM
// ============================================================================

/// Admin action log for audit trail
model AdminActionLog {
  id          String      @id @default(cuid())
  adminUserId String
  action      AdminAction
  targetType  String // Type of entity (e.g., "Market", "User")
  targetId    String // ID of the entity
  metadata    Json? // Additional context
  createdAt   DateTime    @default(now())

  // Relations
  admin User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum MarketStatus {
  DRAFT // Market created but not published
  PUBLISHED // Published but not yet open for trading
  OPEN // Currently accepting bets
  CLOSED // Closed, awaiting resolution
  RESOLVED // Outcome determined
  SETTLED // Payouts distributed
  CANCELLED // Market cancelled/voided
}

enum EventType {
  MATCHUP // Traditional head-to-head (e.g., Team A vs Team B)
  PROP // Multiple outcomes/props (e.g., MVP, Halftime performer)
  TOURNAMENT // Tournament/bracket style
  FUTURES // Long-term predictions
}

enum MarketCategory {
  NFL
  NBA
  NHL
  MLB
  SOCCER
  UFC
  TENNIS
  GOLF
  ESPORTS
  POLITICS
  CRYPTO
  FINANCE
  ENTERTAINMENT
  OTHER
}

enum BetStatus {
  PENDING_TWEET // Awaiting tweet verification
  CONFIRMED // Bet confirmed and active
  WON // Position won
  LOST // Position lost
  REJECTED // Bet rejected (e.g., failed verification)
  CANCELLED // Bet cancelled/refunded
}

enum BalanceReason {
  INITIAL_CREDIT // Initial signup bonus
  BET_PLACED // Funds locked for bet
  SETTLEMENT_PAYOUT // Winnings from settled market
  SETTLEMENT_LOSS // Loss recorded from settled market
  ADMIN_ADJUST // Manual admin adjustment
  REFERRAL_BONUS // Referral reward
  OTHER // Other reasons
  TRADE_SELL // Proceeds from selling shares
}

enum PnLReason {
  TRADE_SELL // Profit/loss from selling shares
  REDEMPTION // Profit/loss from redeeming settled position
  ADMIN_ADJUST // Manual admin adjustment
  RECALCULATION // System recalculation/correction
}

enum TradeType {
  BUY // Buying shares
  SELL // Selling shares
}

enum PricingModel {
  CPMM // Constant Product Market Maker (AMM)
}

enum RaffleReason {
  CORRECT_PREDICTION
  REFERRAL_BONUS
}

enum TweetProofMethod {
  TIMELINE_SCAN // Scan user's timeline for proof
  TWEET_URL // Specific tweet URL provided
}

enum AdminAction {
  MARKET_CREATE
  MARKET_UPDATE
  MARKET_CLOSE
  MARKET_RESOLVE
  MARKET_SETTLE
  USER_ROLE_UPDATE
  USER_UPDATE
  USER_XP_ADJUST
  CONFIG_UPDATE
  EVENT_CREATE
  EVENT_UPDATE
  UPDATE_ROLE
  ADD_ADMIN
  RESOLUTION_SOURCE_CREATE
  RESOLUTION_SOURCE_UPDATE
  RESOLUTION_DATA_CREATE
  RESOLUTION_DATA_UPDATE
  RESOLUTION_DATA_VERIFY
}

enum XPReason {
  TRADE_VOLUME // XP earned from trading volume
  ADMIN_ADJUST // Manual admin adjustment
  BONUS // Promotional bonus
  PENALTY // Penalty/correction
  SHARE_TWEET // XP earned from sharing bet on X
  REFERRAL_BONUS // XP earned from referral (both referrer and referred)
}

enum MarketRequestStatus {
  PENDING // Awaiting admin review
  APPROVED // Approved - market will be created
  REJECTED // Rejected by admin
  CREATED // Market has been created from this request
}

enum ResolutionSourceType {
  INTERNAL // Vault Markets is the authoritative source
  EXTERNAL // External API/website is the source
  HYBRID // Both internal tracking and external verification
}

// ============================================================================
// RESOLUTION SOURCES
// ============================================================================

/// Resolution sources define where market outcomes are determined
model ResolutionSource {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  type        ResolutionSourceType @default(INTERNAL)

  // For external sources
  externalApiUrl    String? // External API endpoint for fetching data
  externalApiHeaders Json?   // Headers for authentication (stored securely)
  
  // Branding/display
  logoUrl    String?
  websiteUrl String?
  
  // Status
  isActive  Boolean @default(true)
  isPublic  Boolean @default(true) // Whether this source is exposed in public API
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  markets    Market[]
  dataPoints ResolutionDataPoint[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
  @@index([isPublic])
}

/// Data points store resolution data for markets
model ResolutionDataPoint {
  id                 String           @id @default(cuid())
  resolutionSourceId String
  resolutionSource   ResolutionSource @relation(fields: [resolutionSourceId], references: [id], onDelete: Cascade)

  // Data identification
  key       String // e.g., "btc_price_2024_eoy", "superbowl_lix_winner"
  label     String? // Human-readable label
  
  // Value storage
  value      String // The resolved value
  valueType  String @default("string") // "string", "number", "boolean", "json"
  
  // Optional market linkage
  marketId String?
  market   Market? @relation(fields: [marketId], references: [id], onDelete: SetNull)
  
  // External verification
  externalValue     String? // Value fetched from external source
  externalFetchedAt DateTime?
  isVerified        Boolean  @default(false)
  verifiedAt        DateTime?
  verifiedBy        String? // Admin user ID who verified
  
  // Context/metadata
  metadata  Json? // Additional context
  notes     String? // Admin notes
  
  // Validity period
  effectiveAt DateTime @default(now()) // When this data point becomes effective
  expiresAt   DateTime? // Optional expiration
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resolutionSourceId, key])
  @@index([resolutionSourceId])
  @@index([marketId])
  @@index([key])
  @@index([effectiveAt])
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================
