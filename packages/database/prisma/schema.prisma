generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  privyUserId      String            @unique
  email            String?
  walletAddress    String?
  twitterSubject   String?
  handle           String?
  name             String?
  profileImageUrl  String?
  role             UserRole          @default(USER)
  balance          Decimal           @default(10000.00) @db.Decimal(19, 2)
  balanceLocked    Boolean           @default(false)
  referralCode     String            @unique @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  realizedPnL      Decimal           @default(0.0000) @db.Decimal(19, 4)
  totalVolume      Decimal           @default(0.00) @db.Decimal(19, 2)
  xp               Int               @default(0) // Total XP earned
  adminActions     AdminActionLog[]
  adminAdjustments BalanceLedger[]   @relation("AdminActor")
  balanceLedger    BalanceLedger[]
  xpLedger         XPLedger[]
  xpAdjustments    XPLedger[]        @relation("XPAdminActor")
  pnlLedger        PnLLedger[]
  bets             Bet[]
  positions        Position[]
  raffleEntries    RaffleEntry[]
  referralReceived Referral?         @relation("ReferredUser")
  referralsGiven   Referral[]        @relation("ReferrerUser")
  tweetProofs      TweetProof[]
  pnlSnapshots     UserPnLSnapshot[]

  @@index([email])
  @@index([twitterSubject])
  @@index([referralCode])
}

model BalanceLedger {
  id               String        @id @default(cuid())
  userId           String
  delta            Decimal       @db.Decimal(19, 2)
  balanceBefore    Decimal       @db.Decimal(19, 2)
  balanceAfter     Decimal       @db.Decimal(19, 2)
  reason           BalanceReason
  correlationId    String?
  actorAdminUserId String?
  createdAt        DateTime      @default(now())
  actorAdmin       User?         @relation("AdminActor", fields: [actorAdminUserId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([correlationId])
  @@index([createdAt])
}

model UserPnLSnapshot {
  id            String   @id @default(cuid())
  userId        String
  realizedPnL   Decimal  @db.Decimal(19, 4)
  unrealizedPnL Decimal  @db.Decimal(19, 4)
  totalVolume   Decimal  @db.Decimal(19, 2)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model XPLedger {
  id            String   @id @default(cuid())
  userId        String
  delta         Int      // XP change (positive or negative)
  xpBefore      Int
  xpAfter       Int
  reason        XPReason
  correlationId String?  // Links to bet/trade ID
  adminUserId   String?  // If admin adjustment
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  admin         User?    @relation("XPAdminActor", fields: [adminUserId], references: [id])

  @@index([userId])
  @@index([userId, createdAt]) // Compound index for user history queries
  @@index([createdAt])
  @@index([reason])
  @@index([correlationId]) // For lookups by trade/bet ID
}

model XPConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON string for flexibility
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // Admin ID who last updated
}

// PnL Ledger for audit trail of all PnL changes
model PnLLedger {
  id            String    @id @default(cuid())
  userId        String
  delta         Decimal   @db.Decimal(19, 4) // PnL change (positive or negative)
  pnlBefore     Decimal   @db.Decimal(19, 4)
  pnlAfter      Decimal   @db.Decimal(19, 4)
  reason        PnLReason
  correlationId String?   // Links to bet/position ID
  marketId      String?   // Related market
  metadata      Json?     // Additional details (shares, price, etc.)
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  market        Market?   @relation(fields: [marketId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([reason])
  @@index([correlationId])
  @@index([marketId])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]  @relation("EventToTag")
}

model Event {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  category    MarketCategory @default(OTHER)
  bannerUrl   String?
  logoUrl     String?
  startTime   DateTime?
  endTime     DateTime?
  active      Boolean        @default(true)
  closed      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  markets     Market[]
  tags        Tag[]          @relation("EventToTag")

  @@index([category])
  @@index([active])
  @@index([closed])
  @@index([startTime])
}

model Market {
  id                  String          @id @default(cuid())
  question            String
  status              MarketStatus    @default(DRAFT)
  detailsMarkdown     String?
  resolutionSourceUrl String?
  publishedAt         DateTime?
  opensAt             DateTime?
  closesAt            DateTime?
  resolvedAt          DateTime?
  settledAt           DateTime?
  settlementRunId     String?         @unique
  feeBps              Int             @default(100)
  seed0               Decimal         @default(1000.00) @db.Decimal(19, 2)
  seed1               Decimal         @default(1000.00) @db.Decimal(19, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  eventId             String
  outcomes            String          @default("[\"Yes\", \"No\"]")
  outcomePrices       String          @default("[\"0.50\", \"0.50\"]")
  outcomeColors       String?
  resolvedOutcome     Int?
  pool0               Decimal         @default(0.00) @db.Decimal(19, 2)
  pool1               Decimal         @default(0.00) @db.Decimal(19, 2)
  k                   Decimal?        @db.Decimal(38, 4)
  pricingModel        PricingModel    @default(CPMM)
  reserve0            Decimal         @default(1000) @db.Decimal(19, 2)
  reserve1            Decimal         @default(1000) @db.Decimal(19, 2)
  bets                Bet[]
  event               Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  positions           Position[]
  priceSnapshots      PriceSnapshot[]
  raffleEntries       RaffleEntry[]
  tweetProofs         TweetProof[]
  pnlLedger           PnLLedger[]

  @@index([eventId])
  @@index([status])
  @@index([closesAt])
  @@index([publishedAt])
  @@index([pricingModel])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  marketId  String
  price0    Decimal  @db.Decimal(10, 4)
  price1    Decimal  @db.Decimal(10, 4)
  pool0     Decimal  @db.Decimal(19, 2)
  pool1     Decimal  @db.Decimal(19, 2)
  timestamp DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, timestamp])
  @@index([timestamp])
}

model Bet {
  id            String      @id @default(cuid())
  userId        String
  marketId      String
  amount        Decimal     @db.Decimal(19, 2)
  weight        Float       @default(1)
  payout        Decimal?    @db.Decimal(19, 2)
  status        BetStatus   @default(PENDING_TWEET)
  tweetProofId  String?
  createdAt     DateTime    @default(now())
  confirmedAt   DateTime?
  outcomeIndex  Int
  pricePerShare Decimal?    @db.Decimal(10, 4)
  shares        Decimal?    @db.Decimal(19, 4)
  tradeType     TradeType   @default(BUY)
  market        Market      @relation(fields: [marketId], references: [id])
  tweetProof    TweetProof? @relation(fields: [tweetProofId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([outcomeIndex])
  @@index([status])
  @@index([createdAt])
  @@index([tradeType])
  @@index([userId, tradeType, status]) // For PnL calculations
  @@index([userId, status, createdAt]) // For time-based PnL queries
}

model Position {
  id        String    @id @default(cuid())
  userId    String
  marketId  String
  amount0   Decimal   @default(0.00) @db.Decimal(19, 2)
  amount1   Decimal   @default(0.00) @db.Decimal(19, 2)
  weighted0 Float     @default(0)
  weighted1 Float     @default(0)
  lastBetAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  avgCost0  Decimal   @default(0) @db.Decimal(10, 4)
  avgCost1  Decimal   @default(0) @db.Decimal(10, 4)
  shares0   Decimal   @default(0) @db.Decimal(19, 4)
  shares1   Decimal   @default(0) @db.Decimal(19, 4)
  claimedAt DateTime? // When user claimed their payout for this position
  market    Market    @relation(fields: [marketId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, marketId])
  @@index([userId])
  @@index([marketId])
  @@index([userId, claimedAt]) // For unclaimed positions queries
}

model Referral {
  id                  String    @id @default(cuid())
  referrerUserId      String
  referredUserId      String    @unique
  createdAt           DateTime  @default(now())
  qualifiedAt         DateTime?
  bonusEntriesAwarded Int       @default(0)
  referred            User      @relation("ReferredUser", fields: [referredUserId], references: [id])
  referrer            User      @relation("ReferrerUser", fields: [referrerUserId], references: [id])

  @@index([referrerUserId])
}

model RaffleEntry {
  id        String       @id @default(cuid())
  userId    String
  marketId  String
  entries   Int          @default(1)
  reason    RaffleReason
  createdAt DateTime     @default(now())
  market    Market       @relation(fields: [marketId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, marketId, reason])
  @@index([userId])
  @@index([marketId])
}

model TweetProof {
  id          String           @id @default(cuid())
  userId      String
  marketId    String
  method      TweetProofMethod
  tweetUrl    String?
  tweetId     String?
  verified    Boolean          @default(false)
  matchedText String?
  raw         Json?
  createdAt   DateTime         @default(now())
  verifiedAt  DateTime?
  bets        Bet[]
  market      Market           @relation(fields: [marketId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([verified])
}

model AdminActionLog {
  id          String      @id @default(cuid())
  adminUserId String
  action      AdminAction
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime    @default(now())
  admin       User        @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum MarketStatus {
  DRAFT
  PUBLISHED
  OPEN
  CLOSED
  RESOLVED
  SETTLED
  CANCELLED
}

enum MarketCategory {
  NFL
  NBA
  NHL
  MLB
  SOCCER
  UFC
  TENNIS
  GOLF
  ESPORTS
  POLITICS
  CRYPTO
  FINANCE
  ENTERTAINMENT
  OTHER
}

enum BetStatus {
  PENDING_TWEET
  CONFIRMED
  WON
  LOST
  REJECTED
  CANCELLED
}

enum BalanceReason {
  INITIAL_CREDIT
  BET_PLACED
  SETTLEMENT_PAYOUT
  SETTLEMENT_LOSS
  ADMIN_ADJUST
  REFERRAL_BONUS
  OTHER
  TRADE_SELL
}

enum PnLReason {
  TRADE_SELL        // Profit/loss from selling shares
  REDEMPTION        // Profit/loss from redeeming settled position
  ADMIN_ADJUST      // Admin adjustment
  RECALCULATION     // System recalculation/correction
}

enum TradeType {
  BUY
  SELL
}

enum PricingModel {
  PARI_MUTUEL
  CPMM
}

enum RaffleReason {
  CORRECT_PREDICTION
  REFERRAL_BONUS
}

enum TweetProofMethod {
  TIMELINE_SCAN
  TWEET_URL
}

enum AdminAction {
  MARKET_CREATE
  MARKET_UPDATE
  MARKET_CLOSE
  MARKET_RESOLVE
  MARKET_SETTLE
  USER_ROLE_UPDATE
  USER_XP_ADJUST
  CONFIG_UPDATE
  EVENT_CREATE
  EVENT_UPDATE
}

enum XPReason {
  TRADE_VOLUME  // XP from trading
  ADMIN_ADJUST  // Manual admin adjustment
  BONUS         // Promotional bonus
  PENALTY       // Penalty/correction
}
